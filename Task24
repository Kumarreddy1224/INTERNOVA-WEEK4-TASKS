public class Task24 {
    static int square(int n) {
        return n * n;
    }
 static int cube(int n) {
        return n * n * n;
    }
  static int average(int a, int b, int c) {
        return a + b + c / 3;
    }
  static int maximum(int a, int b) {
        if (a > b)
            return a;
        else
            return b;
    }
  public static void main(String[] args) {
 int num = 6;
        int square = square(num);
        int cube = cube(num);
